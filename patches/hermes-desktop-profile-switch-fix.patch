 import { SETTINGS_ROUTE } from '../routes'
@@ -75,7 +76,8 @@ export function useGatewayScopeRefresh(
   activeConnectionId: null | string,
   activeGatewayProfile: string,
   refreshCurrentModel: (force: boolean) => Promise<unknown>,
-  refreshHermesConfig: (force: boolean) => Promise<unknown>
+  refreshHermesConfig: (force: boolean) => Promise<unknown>,
+  refreshSessions: () => Promise<unknown> | unknown
 ) {
   const gatewayScope = `${activeConnectionId ?? ''}\0${activeGatewayProfile}`
   const lastGatewayScopeRef = useRef(gatewayScope)
@@ -95,5 +97,24 @@ export function useGatewayScopeRefresh(
     void refreshHermesConfig(true)
     void refreshActiveProfile()
     resetProjectTreeState()
-  }, [gatewayScope, refreshCurrentModel, refreshHermesConfig])
+    // The sidebar's session rows live in nanostores, not React Query, so a
+    // scope move owes an explicit pull: the only other trigger left is an
+    // effect that bails while the gateway is not `open`, and a PROFILE PICK
+    // reaches here with that socket still being dialed — the pick had already
+    // wiped the outgoing rows and armed the skeleton, so nothing else asked
+    // again and the list sat empty until the user hit Refresh. Asking here is
+    // ordering-safe: this passive effect runs after the layout effect that
+    // repoints the list hook's profileScopeRef, so the request is not dropped
+    // as belonging to the profile the window just left. A no-op refusal (the
+    // scope moved again, or the backend is still dialing) is best-effort: the
+    // socket-open effect and the activation-epoch re-read both still cover it.
+    void Promise.resolve()
+      .then(() => refreshSessions())
+      .catch(() => undefined)
+    // The grouped sidebar's rows come from the project overview, which the pick
+    // wipes; without an explicit re-pull the group stays empty until some
+    // unrelated projects.changed tick lands.
+    void refreshProjects().catch(() => undefined)
+    void refreshProjectTree().catch(() => undefined)
+  }, [gatewayScope, refreshCurrentModel, refreshHermesConfig, refreshSessions])
 }
