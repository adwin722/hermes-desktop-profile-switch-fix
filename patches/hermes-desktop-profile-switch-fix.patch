+import { atom } from 'nanostores'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// The gateway socket layer must not run for real: a profile pick's activation
+// is the thing under test, and it is driven to whatever state each case needs.
+const ensureGatewayForProfile = vi.fn(async (_profile: string) => undefined)
+const ensureGatewayForAgent = vi.fn(async (_connectionId: string, _profile: string) => undefined)
+const openGatewayForProfile = vi.fn(async (_profile: string) => undefined)
+const openGatewayForAgent = vi.fn(async (_connectionId: null | string, _profile: string) => undefined)
+const activeGatewayConnectionId = vi.fn((): null | string => null)
+const $gateway = atom<unknown>({ id: 'live-socket', connectionState: 'open' })
+
+vi.mock('@/store/gateway', () => ({
+  $gateway,
+  activeGateway: () => null,
+  activeGatewayConnectionId,
+  activeGatewayProfileKey: () => ensureGatewayForProfile.mock.lastCall?.[0] ?? null,
+  ensureGatewayForAgent,
+  ensureGatewayForProfile,
+  openGatewayForAgent,
+  openGatewayForProfile,
+  openSecondaryCount: () => 0
+}))
+vi.mock('@/hermes', () => ({
+  getProfiles: vi.fn(async () => ({ profiles: [] })),
+  setApiRequestProfile: vi.fn()
+}))
+vi.mock('@/lib/query-client', () => ({ invalidateProfileScopedQueries: vi.fn() }))
+vi.mock('@/store/starmap', () => ({ reloadOpenStarmapGraph: vi.fn(), resetStarmapGraph: vi.fn() }))
+// The failure path toasts; the real store reaches for window timers, which the
+// stub below (hermesDesktop only) does not provide.
+vi.mock('@/store/notifications', () => ({ notify: vi.fn(), notifyError: vi.fn() }))
+
+const { $activeGatewayProfile, $profileSwitchTarget, selectProfile } = await import('./profile')
+// Importing this module registers the sidebar-only wipe bridge (the profile
+// store deliberately does not import it back — that would close a cycle).
+const { registerGatewaySwitchLifecycle } = await import('./gateway-switch')
+const { $sessions, $sessionsLoading, setSessions } = await import('./session')
+
+const row = (id: string) => ({ id, profile: 'default', source: 'desktop', title: id }) as never
+
+beforeEach(() => {
+  ensureGatewayForProfile.mockReset()
+  ensureGatewayForProfile.mockResolvedValue(undefined)
+  $gateway.set({ id: 'live-socket', connectionState: 'open' })
+  $activeGatewayProfile.set('default')
+  $profileSwitchTarget.set(null)
+  $sessionsLoading.set(false)
+  vi.stubGlobal('window', { hermesDesktop: { getConnection: vi.fn(async () => ({ mode: 'local', profile: 'default' })) } })
+})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  setSessions([])
+})
+
+describe('profile pick enters the switch state before dialing', () => {
+  it('drops the outgoing rows, arms the skeleton and marks the target synchronously', async () => {
+    // Activation parked: the real dial is a multi-second `hermes gateway ensure`
+    // spawn, so the interesting frame is the one BEFORE it settles. Released
+    // before the case ends — ensureGatewayProfile serializes switches behind
+    // that promise, and a case that leaves it hanging wedges every later one.
+    let release!: () => void
+    ensureGatewayForProfile.mockImplementation(
+      () => new Promise<undefined>(resolve => {
+        release = () => resolve(undefined)
+      })
+    )
+    setSessions([row('old-1'), row('old-2')])
+    $sessionsLoading.set(false)
+
+    selectProfile('work')
+
+    // Synchronous, same tick as the click — no await between pick and wipe.
+    expect($profileSwitchTarget.get()).toBe('work')
+    expect($sessions.get()).toHaveLength(0)
+    expect($sessionsLoading.get()).toBe(true)
+
+    // The dial is reached on a later microtask (the module awaits the served-
+    // profile refresh first); wait for it, then let it settle.
+    await vi.waitFor(() => {
+      expect(typeof release).toBe('function')
+    })
+    release()
+    await vi.waitFor(() => {
+      expect($profileSwitchTarget.get()).toBeNull()
+    })
+  })
+
+  it('does not enter the switch state when the picked profile is already active', () => {
+    setSessions([row('keep-1')])
+
+    selectProfile('default')
+
+    expect($profileSwitchTarget.get()).toBeNull()
+    expect($sessions.get()).toHaveLength(1)
+    expect($sessionsLoading.get()).toBe(false)
+  })
+
+  it('repaints the still-active source and clears the target when the dial fails', async () => {
+    const refreshSessions = vi.fn(async () => undefined)
+    registerGatewaySwitchLifecycle({ beforeConnectionSwitch: vi.fn(), refreshSessions })
+    ensureGatewayForProfile.mockRejectedValue(new Error('backend unreachable'))
+    setSessions([row('old-1')])
+
+    selectProfile('work')
+
+    // Settle the activation promise chain.
+    await vi.waitFor(() => {
+      expect($profileSwitchTarget.get()).toBeNull()
+    })
+
+    expect(refreshSessions).toHaveBeenCalled()
+    expect($sessionsLoading.get()).toBe(false)
+    // The pill stays on the profile that is still served (#81094).
+    expect($activeGatewayProfile.get()).toBe('default')
+  })
+
+  it('clears the target after a successful dial', async () => {
+    setSessions([row('old-1')])
+
+    selectProfile('work')
+
+    await vi.waitFor(() => {
+      expect($profileSwitchTarget.get()).toBeNull()
+    })
+
+    expect(ensureGatewayForProfile).toHaveBeenCalledWith('work')
+  })
+})
