diff --git a/apps/desktop/src/app/contrib/wiring-effects.gateway-scope-refresh.test.tsx b/apps/desktop/src/app/contrib/wiring-effects.gateway-scope-refresh.test.tsx
new file mode 100644
index 0000000000..e7afaef7d4
--- /dev/null
+++ b/apps/desktop/src/app/contrib/wiring-effects.gateway-scope-refresh.test.tsx
@@ -0,0 +1,117 @@
+import { cleanup, renderHook, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { useGatewayScopeRefresh } from './wiring-effects'
+
+const refreshActiveProfile = vi.fn(async () => undefined)
+const resetProjectTreeState = vi.fn()
+
+vi.mock('@/store/profile', async original => ({
+  ...(await original<Record<string, unknown>>()),
+  refreshActiveProfile: () => refreshActiveProfile()
+}))
+
+vi.mock('../right-sidebar/files/use-project-tree', async original => ({
+  ...(await original<Record<string, unknown>>()),
+  resetProjectTreeState: () => resetProjectTreeState()
+}))
+
+function mount(args: {
+  connectionId: null | string
+  profile: string
+  refreshSessions?: () => Promise<unknown> | unknown
+}) {
+  const refreshCurrentModel = vi.fn(async () => undefined)
+  const refreshHermesConfig = vi.fn(async () => undefined)
+  const refreshSessions = vi.fn(args.refreshSessions ?? (async () => undefined))
+
+  const hook = renderHook(
+    (props: { connectionId: null | string; profile: string }) =>
+      useGatewayScopeRefresh(
+        props.connectionId,
+        props.profile,
+        refreshCurrentModel,
+        refreshHermesConfig,
+        refreshSessions
+      ),
+    { initialProps: { connectionId: args.connectionId, profile: args.profile } }
+  )
+
+  return { ...hook, refreshSessions, refreshCurrentModel, refreshHermesConfig }
+}
+
+beforeEach(() => {
+  refreshActiveProfile.mockClear()
+  resetProjectTreeState.mockClear()
+})
+
+afterEach(cleanup)
+
+describe('useGatewayScopeRefresh', () => {
+  it('does not pull anything on the initial scope', () => {
+    const { refreshSessions, refreshCurrentModel } = mount({ connectionId: 'local', profile: 'demand' })
+
+    expect(refreshSessions).not.toHaveBeenCalled()
+    expect(refreshCurrentModel).not.toHaveBeenCalled()
+  })
+
+  // The regression this hook now guards: a profile pick wipes the sidebar rows
+  // and arms the skeleton, then moves $activeGatewayProfile. The socket-open
+  // effect bails while the target backend is still being dialed, so nothing
+  // asked for the new scope's rows and the list stayed empty until the user hit
+  // Refresh. The scope move itself is the moment a pull is owed.
+  it('pulls the sidebar list when the profile moves', async () => {
+    const { refreshSessions, refreshCurrentModel, refreshHermesConfig, rerender } = mount({
+      connectionId: 'local',
+      profile: 'demand'
+    })
+
+    rerender({ connectionId: 'local', profile: 'code-assistant' })
+
+    await waitFor(() => expect(refreshSessions).toHaveBeenCalledTimes(1))
+    expect(refreshCurrentModel).toHaveBeenCalledWith(true)
+    expect(refreshHermesConfig).toHaveBeenCalledWith(true)
+    expect(refreshActiveProfile).toHaveBeenCalledTimes(1)
+    expect(resetProjectTreeState).toHaveBeenCalledTimes(1)
+  })
+
+  it('pulls the sidebar list when the connection moves', async () => {
+    const { refreshSessions, rerender } = mount({ connectionId: 'local', profile: 'default' })
+
+    rerender({ connectionId: 'remote-1', profile: 'default' })
+
+    await waitFor(() => expect(refreshSessions).toHaveBeenCalledTimes(1))
+  })
+
+  // Same scope, new callback identity (every parent render): the scope guard
+  // must keep it from re-pulling the list on each render.
+  it('does not re-pull for a re-render that keeps the scope', async () => {
+    const { refreshSessions, rerender } = mount({ connectionId: 'local', profile: 'demand' })
+
+    rerender({ connectionId: 'local', profile: 'demand' })
+    rerender({ connectionId: 'local', profile: 'demand' })
+
+    expect(refreshSessions).not.toHaveBeenCalled()
+  })
+
+  it('swallows a failed pull instead of surfacing an unhandled rejection', async () => {
+    const onUnhandled = vi.fn()
+    process.on('unhandledRejection', onUnhandled)
+
+    try {
+      const { refreshSessions, rerender } = mount({
+        connectionId: 'local',
+        profile: 'demand',
+        refreshSessions: () => Promise.reject(new Error('backend still dialing'))
+      })
+
+      rerender({ connectionId: 'local', profile: 'code-assistant' })
+
+      await waitFor(() => expect(refreshSessions).toHaveBeenCalledTimes(1))
+      await new Promise(resolve => setTimeout(resolve, 20))
+      expect(onUnhandled).not.toHaveBeenCalled()
+    } finally {
+      process.off('unhandledRejection', onUnhandled)
+    }
+  })
+})
